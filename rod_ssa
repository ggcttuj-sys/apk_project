    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700;900&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-black: #050508;
            --card-bg: #0b0c10;
            --red-glow: #ff003c;
            --green-glow: #00ff66;
            --cyan-glow: #00f0ff;
            --purple-glow: #9d00ff;
            --text-main: #e0e0e0;
            --text-muted: #888899;
            --border-color: #1f1f2e;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Tajawal', sans-serif;
            scroll-behavior: smooth;
        }

        body {
            background-color: var(--bg-black);
            color: var(--text-main);
            overflow-x: hidden;
            line-height: 1.8;
        }

        /* Scrollbar الهكر */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #000;
        }
        ::-webkit-scrollbar-thumb {
            background: var(--red-glow);
            border-radius: 4px;
        }

        /* --- قسم الفيديو العلوي (Hero Section) --- */
        .hero {
            position: relative;
            width: 100%;
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            overflow: hidden;
        }

        .hero video {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            min-width: 100%;
            min-height: 100%;
            object-fit: cover;
            z-index: 1;
            filter: brightness(0.35) contrast(1.3) hue-rotate(320deg);
        }

        .hero-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle, rgba(5,5,8,0.2) 0%, rgba(5,5,8,0.95) 90%);
            z-index: 2;
        }

        .live-badge {
            position: absolute;
            top: 25px;
            right: 25px;
            background: rgba(15, 0, 0, 0.85);
            border: 1px solid var(--red-glow);
            color: #fff;
            padding: 6px 16px;
            border-radius: 30px;
            font-size: 13px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 8px;
            z-index: 3;
            box-shadow: 0 0 15px rgba(255, 0, 60, 0.5);
            letter-spacing: 1px;
        }

        .live-dot {
            width: 8px;
            height: 8px;
            background-color: var(--red-glow);
            border-radius: 50%;
            animation: pulse-red 1.2s infinite;
        }

        @keyframes pulse-red {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(255, 0, 60, 0.7); }
            70% { transform: scale(1.2); box-shadow: 0 0 0 10px rgba(255, 0, 60, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(255, 0, 60, 0); }
        }

        .hero-content {
            position: relative;
            z-index: 3;
            max-width: 850px;
            padding: 0 20px;
        }

        .platform-title {
            font-size: 3.5rem;
            font-weight: 900;
            color: #fff;
            text-transform: uppercase;
            letter-spacing: 2px;
            text-shadow: 0 0 20px var(--red-glow);
            margin-bottom: 10px;
        }

        .owner-badge {
            display: inline-block;
            background: linear-gradient(90deg, #ff003c, #9d00ff);
            color: #fff;
            padding: 4px 20px;
            border-radius: 6px;
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 20px;
            box-shadow: 0 0 15px rgba(157, 0, 255, 0.4);
        }

        /* شاشة أوامر التفاعلية */
        .terminal-text {
            color: var(--green-glow);
            font-family: monospace;
            font-size: 1.1rem;
            margin-bottom: 25px;
            background: rgba(0, 0, 0, 0.75);
            padding: 10px 20px;
            border-radius: 8px;
            border: 1px solid rgba(0, 255, 102, 0.3);
            display: inline-block;
        }

        .hero-action-btns {
            display: flex;
            gap: 15px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .start-btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: #000;
            color: #fff;
            border: 2px solid var(--red-glow);
            padding: 14px 32px;
            font-size: 17px;
            font-weight: 800;
            border-radius: 8px;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.3s ease;
            box-shadow: 0 0 20px rgba(255, 0, 60, 0.4);
        }

        .start-btn:hover {
            background: var(--red-glow);
            color: #000;
            box-shadow: 0 0 35px var(--red-glow);
            transform: translateY(-3px);
        }

        .channel-btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: rgba(0, 240, 255, 0.1);
            color: var(--cyan-glow);
            border: 2px solid var(--cyan-glow);
            padding: 14px 28px;
            font-size: 17px;
            font-weight: 800;
            border-radius: 8px;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.3s ease;
            box-shadow: 0 0 15px rgba(0, 240, 255, 0.2);
        }

        .channel-btn:hover {
            background: var(--cyan-glow);
            color: #000;
            box-shadow: 0 0 30px var(--cyan-glow);
            transform: translateY(-3px);
        }

        /* شريط الأخبار والتحذيرات المتحرك */
        .ticker-bar {
            position: absolute;
            bottom: 0;
            width: 100%;
            background: rgba(10, 10, 15, 0.9);
            border-top: 1px solid var(--red-glow);
            padding: 8px 0;
            overflow: hidden;
            white-space: nowrap;
            z-index: 3;
            font-family: monospace;
            font-size: 13px;
            color: var(--green-glow);
        }

        .ticker-content {
            display: inline-block;
            animation: ticker 25s linear infinite;
        }

        @keyframes ticker {
            0% { transform: translateX(100%); }
            100% { transform: translateX(-100%); }
        }

        /* --- الحاوية الرئيسية والمقاطع --- */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 80px 20px;
        }

        .section-header {
            text-align: center;
            margin-bottom: 60px;
        }

        .section-header h2 {
            font-size: 2.5rem;
            font-weight: 900;
            color: #fff;
            margin-bottom: 10px;
        }

        .section-header p {
            color: var(--text-muted);
            font-size: 1.1rem;
        }

        /* شبكة الأقسام الرئيسية */
        .sections-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(500px, 1fr));
            gap: 30px;
        }

        @media (max-width: 600px) {
            .sections-grid { grid-template-columns: 1fr; }
            .platform-title { font-size: 2.2rem; }
        }

        /* بطاقة القسم */
        .cyber-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 35px;
            position: relative;
            overflow: hidden;
            transition: all 0.4s ease;
        }

        .cyber-card::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 100%;
            height: 3px;
            background: var(--card-accent, var(--red-glow));
            box-shadow: 0 0 15px var(--card-accent, var(--red-glow));
        }

        .cyber-card:hover {
            transform: translateY(-8px);
            border-color: var(--card-accent, var(--red-glow));
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8);
        }

        .card-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 25px;
        }

        .card-title-group {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .card-icon {
            width: 55px;
            height: 55px;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            color: var(--card-accent);
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.5);
        }

        .card-title-group h3 {
            font-size: 1.5rem;
            font-weight: 800;
            color: #fff;
        }

        .card-img-preview {
            width: 70px;
            height: 70px;
            border-radius: 10px;
            object-fit: cover;
            border: 1px solid var(--border-color);
            filter: grayscale(40%) contrast(120%);
        }

        .card-body p {
            color: var(--text-main);
            font-size: 15px;
            margin-bottom: 20px;
            text-align: justify;
        }

        .card-list {
            list-style: none;
            padding-top: 15px;
        }

        .card-list li {
            position: relative;
            padding-right: 25px;
            margin-bottom: 12px;
            color: var(--text-muted);
            font-size: 14px;
        }

        .card-list li::before {
            content: '➢';
            position: absolute;
            right: 0;
            color: var(--card-accent);
            font-weight: bold;
        }

        /* --- قسم الأدوات التفاعلي --- */
        .tools-section {
            margin-top: 100px;
            background: linear-gradient(180deg, transparent 0%, rgba(255, 0, 60, 0.03) 50%, transparent 100%);
            padding: 60px 20px;
            border-radius: 20px;
            border: 1px solid var(--border-color);
        }

        .tools-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            margin-top: 40px;
        }

        .tool-box {
            background: #000;
            border: 1px solid #1a1a24;
            padding: 20px;
            border-radius: 10px;
            text-align: center;
            transition: 0.3s;
        }

        .tool-box:hover {
            border-color: var(--cyan-glow);
            box-shadow: 0 0 15px rgba(0, 240, 255, 0.2);
        }

        .tool-box i {
            font-size: 32px;
            color: var(--cyan-glow);
            margin-bottom: 12px;
        }

        .tool-box h4 {
            color: #fff;
            margin-bottom: 8px;
        }

        .tool-box span {
            font-size: 12px;
            color: var(--text-muted);
            display: block;
        }

        /* أزرار التواصل والتليكرام العائمة */
        .telegram-float-group {
            position: fixed;
            bottom: 25px;
            left: 25px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            z-index: 99;
        }

        .float-btn {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            text-decoration: none;
            transition: all 0.3s ease;
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.8);
        }

        .float-personal {
            background: var(--red-glow);
            color: #000;
            box-shadow: 0 0 20px var(--red-glow);
        }

        .float-channel {
            background: var(--cyan-glow);
            color: #000;
            box-shadow: 0 0 20px var(--cyan-glow);
        }

        .float-btn:hover {
            transform: scale(1.15);
        }

        /* --- الفوتر --- */
        footer {
            text-align: center;
            padding: 40px 20px;
            border-top: 1px solid var(--border-color);
            background: #000;
            color: var(--text-muted);
            font-size: 14px;
        }

        footer strong {
            color: var(--red-glow);
        }

        footer a {
            color: var(--cyan-glow);
            text-decoration: none;
        }
    </style>
</head>
